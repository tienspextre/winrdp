[Desktop Entry]
Type=Application
Name=WinRDP
GenericName=Remote Desktop Client
Comment=Windows-native Remote Desktop experience for Ubuntu (FreeRDP 3 + OpenGL)
Exec=@WINRDP_BIN@ %u
Icon=io.winrdp.Client
Terminal=false
Categories=Network;RemoteAccess;
MimeType=application/x-rdp;x-scheme-handler/rdp;
StartupWMClass=io.winrdp.Client
Keywords=RDP;Remote Desktop;Windows;mstsc;Thincast;
